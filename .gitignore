# ─── Next.js build output ───────────────────────────────────────────────────
/.next/
!out/
# ─── GitHub Pages ──────────────────────────────────────────────────────────
!.nojekyll
build/

# ─── Node modules ────────────────────────────────────────────────────────────
node_modules/

# ─── Environment variables ───────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Package manager logs ────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor / IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── PWA (generated by next-pwa on build) ────────────────────────────────────
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel